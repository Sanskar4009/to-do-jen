# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-me-to-a-secure-random-key-in-production
PORT=5000

# AWS Configuration
AWS_REGION=us-east-1
DYNAMODB_TABLE=cloudtodo-tasks

# Amazon SNS Configuration (optional for local dev, leave blank to skip notifications)
SNS_TOPIC_ARN=

# Optional: Custom DynamoDB Endpoint for local development (e.g. LocalStack or dynamodb-local)
# DYNAMODB_ENDPOINT_URL=http://localhost:8000
